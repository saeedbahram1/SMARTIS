# ==============================================================================
# Smartis Voice Assistant — Configuration & Environment Variables
# ==============================================================================
# Note: All settings below are standard configuration parameters with built-in
# safe defaults. The application will run smoothly even if some or all are unset.
# No secret API keys or cloud credentials are required for standard operation.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Network & Backend Server
# ------------------------------------------------------------------------------
# For Local Windows Execution:
# The Python backend runs locally on 127.0.0.1:8765.
# Flutter Desktop connects to this local backend.
# The AI Studio web preview functions independently without local PC backend dependency.
SMARTIS_HOST=127.0.0.1
SMARTIS_PORT=8765

# ------------------------------------------------------------------------------
# 2. Audio & Microphone Configuration
# ------------------------------------------------------------------------------
# Microphone Device Index:
# Leave blank (or set to "") to use the Windows Default Microphone.
# To use a specific hardware device, enter its integer index (e.g., 0, 1, 2).
SMARTIS_MIC_DEVICE_INDEX=

# Google Web Speech Recognition Languages (Online STT via recognize_google)
SMARTIS_GOOGLE_FA_LANGUAGE=fa-IR
SMARTIS_GOOGLE_EN_LANGUAGE=en-US

# SpeechRecognizer calibration duration in seconds (adjusts to room background noise)
SMARTIS_ENERGY_THRESHOLD=75.0
SMARTIS_AMBIENT_CALIBRATION_SECONDS=0.3

# Maximum recording duration for a single command in seconds
SMARTIS_PHRASE_TIME_LIMIT_SECONDS=18.0

# Silence pause duration before considering speech finished
SMARTIS_PAUSE_THRESHOLD=0.7

# Non-speaking duration retained at the start/end of recording
SMARTIS_NON_SPEAKING_DURATION=0.35

# Minimum audio energy threshold to initiate phrase recognition
SMARTIS_PHRASE_THRESHOLD=0.08

# Timeout for Google Web Speech recognition HTTP request in seconds
SMARTIS_GOOGLE_TIMEOUT=3.0

# Maximum audio duration listened per wake-word cycle in seconds
SMARTIS_WAKE_TIME_LIMIT=3.5

# ------------------------------------------------------------------------------
# 3. Text-to-Speech (TTS) Settings
# ------------------------------------------------------------------------------
# Online TTS voices (powered by edge-tts)
SMARTIS_TTS_FA_VOICE=fa-IR-DilaraNeural
SMARTIS_TTS_EN_VOICE=en-US-GuyNeural

# Speech rate, volume, and pitch adjustments
SMARTIS_TTS_RATE=+0%
SMARTIS_TTS_VOLUME=+0%
SMARTIS_TTS_PITCH=+0Hz

# ------------------------------------------------------------------------------
# 4. Offline STT Fallback (faster-whisper)
# ------------------------------------------------------------------------------
# Path to local whisper model folder (leave empty to use default backend/models/whisper-small)
WHISPER_MODEL=
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ------------------------------------------------------------------------------
# 5. Local LLM / Ollama (Optional for complex planning)
# ------------------------------------------------------------------------------
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
AGENT_TIMEOUT=30.0

# ------------------------------------------------------------------------------
# 6. Connectivity Cache & Timeouts
# ------------------------------------------------------------------------------
SMARTIS_INTERNET_TIMEOUT=1.5
SMARTIS_INTERNET_CACHE=4.0
