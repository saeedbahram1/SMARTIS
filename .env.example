# Smartis Configuration

# Host and Port
SMARTIS_HOST=127.0.0.1
SMARTIS_PORT=8765

# Microphone device index (leave empty for default microphone)
SMARTIS_MIC_DEVICE_INDEX=

# Google Speech Recognition Languages
SMARTIS_GOOGLE_FA_LANGUAGE=fa-IR
SMARTIS_GOOGLE_EN_LANGUAGE=en-US

# SpeechRecognizer calibration & thresholds
SMARTIS_AMBIENT_CALIBRATION_SECONDS=0.7
SMARTIS_PHRASE_TIME_LIMIT_SECONDS=18.0
SMARTIS_PAUSE_THRESHOLD=1.0
SMARTIS_NON_SPEAKING_DURATION=0.45
SMARTIS_PHRASE_THRESHOLD=0.12
SMARTIS_GOOGLE_TIMEOUT=6.0
SMARTIS_WAKE_TIME_LIMIT=3.5

# TTS voices (online: edge-tts)
SMARTIS_TTS_FA_VOICE=fa-IR-DilaraNeural
SMARTIS_TTS_EN_VOICE=en-US-GuyNeural
SMARTIS_TTS_RATE=+0%
SMARTIS_TTS_VOLUME=+0%
SMARTIS_TTS_PITCH=+0Hz

# Offline Whisper STT
WHISPER_MODEL=
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Ollama LLM
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
AGENT_TIMEOUT=30
