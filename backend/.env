WHISPER_MODEL=models/whisper-small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
AGENT_TIMEOUT=30

# Online STT is handled by Google's Web Speech API via the SpeechRecognition
# library — no API key needed. It is used automatically whenever the internet
# check succeeds; otherwise the local (offline) Whisper model is used.

# Online TTS
SMARTIS_TTS_FA_VOICE=fa-IR-DilaraNeural
SMARTIS_TTS_EN_VOICE=en-US-GuyNeural
