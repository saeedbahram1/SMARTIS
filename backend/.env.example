# Smartis 2.15 - performance-oriented defaults
# Copy to .env and adjust only when you need different behavior.

# Ollama / chat
# qwen3.5:4b is the default brain (~3.4 GB on disk, fits 8 GB RAM with the
# 2048-token context). A different installed Qwen is used automatically
# if this tag is missing.
SMARTIS_CHAT_MODEL=qwen3.5:4b
OLLAMA_MODEL=qwen3.5:4b
SMARTIS_NUM_CTX=2048
# 240 s / 180 s: MEASURED on an 8 GB machine, a full attachment prompt needs
# 132.6 s to the first token and 178.2 s worst total. Shorter values abort
# answers while the model is still prefilling.
SMARTIS_CHAT_TIMEOUT=240
SMARTIS_CHAT_FIRST_TOKEN_TIMEOUT=180
SMARTIS_CHAT_TEMPERATURE=0.65
SMARTIS_CHAT_MAX_TOKENS=260
SMARTIS_THINK_MAX_TOKENS=700
SMARTIS_CHAT_MAX_CHARS=1800
SMARTIS_CHAT_KEEP_WARM=1
# 0 = auto: Ollama uses the physical core count. Cap it (e.g. 4) to leave CPU
# headroom for other apps while the model is generating.
SMARTIS_OLLAMA_THREADS=0

# Agent execution
AGENT_TIMEOUT=25

# Speech / microphone
# 0 = auto (all CPU cores, capped at 8). A fixed 4 leaves half of an 8-core
# machine idle during every STT decode.
SHERPA_NUM_THREADS=0
SMARTIS_NOISE_GATE=strict
SMARTIS_SPEAK_TAIL_GUARD=0.55

# Service endpoints
OLLAMA_URL=http://127.0.0.1:11434
SMARTIS_HOST=127.0.0.1
SMARTIS_PORT=8765
