

# ==============================================================================
# Smartis 2.2 — Conversational layer + self-voice protection
# ==============================================================================
# The conversational layer runs on the SAME local Ollama model that already
# powers the planner. No paid cloud API (OpenAI / Gemini / ...) is required.
SMARTIS_CHAT_MODEL=qwen2.5:7b
SMARTIS_CHAT_TIMEOUT=20
SMARTIS_CHAT_TEMPERATURE=0.65
SMARTIS_CHAT_MAX_TOKENS=450
SMARTIS_CHAT_MAX_CHARS=1800
SMARTIS_CHAT_KEEP_WARM=1

# Noise gate: "relaxed" (default) answers every plausible sentence.
# Use "strict" to restore the old aggressive noise filter.
SMARTIS_NOISE_GATE=relaxed

# Self-voice (echo) protection.
# SMARTIS_SPEAK_TAIL_GUARD: extra seconds the microphone stays muted after speech.
# SMARTIS_ECHO_WINDOW / SMARTIS_ECHO_THRESHOLD: how long Smartis remembers what it
# said, and how similar a transcript must be to be treated as its own voice.
SMARTIS_SPEAK_TAIL_GUARD=1.6
SMARTIS_ECHO_WINDOW=30
SMARTIS_ECHO_THRESHOLD=0.60
